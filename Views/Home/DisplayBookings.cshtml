@{
    ViewData["Title"] = "Display Bookings";
}

@model List<Booking>

    <div class="text-center">
        <h1 class="dispay-4">Bookings</h1>
        <br/>
        <div class="row">
            <div class="col-md-6"></div>
            <form class="d-flex" asp-action="Index" asp-asp-controller="Home">
                <input name="searchString" class="form-control me-1" type="search" placeholder="Search" aria-label="Search" />
                <button class="btn btn-dark" type="submit">Search by name</button>
            </form>
            <div class="col-md-t">
                <a asp-action="Index" class="text-dark">Back to Full list</a>
            </div>
        </div>
        <table class="table">
            <thead>
            <tr>
                    <th>BookingId</th>
                    <th>BookingName</th>
                    <th>VenueId</th>
                    <th>EventId</th>
                    <th>BookingDate</th>
                    <th>Actions</th>
            </tr>
                
            </thead>
            <tbody>
            @{
                if (Model != null)
                    foreach (var booking in Model)
                    {
                        <tr>
                            <td>@booking.BookingId</td>
                            <td>@booking.BookingName</td>
                            <td>@booking.VenueId</td>
                            <td>@booking.EventId</td>
                            <td>@booking.BookingDate</td>
                            <td>
                              <a asp-action="Booking" asp-route-itemid="@booking.BookingId">Edit</a>
                              <a asp-action="DeleteBooking" asp-route-itemid="@booking.BookingId">Delete</a>
                              <a asp-action="BookingForm" asp-route-itemid="@booking.BookingId">Add</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>